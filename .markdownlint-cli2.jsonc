{
  "config": {
    "default": true,
    // MD013 line-length: prose docs wrap at varying widths; let the writer
    // decide rather than fight code blocks and tables.
    "MD013": false,
    // MD024 duplicate headings: only flag siblings. Sub-sections often share
    // names across different parents (e.g. "Pros" / "Cons" under each option).
    "MD024": { "siblings_only": true },
    // MD033 inline HTML: Obsidian callouts and admonitions sometimes need raw
    // HTML for icons/styling; don't fight them.
    "MD033": false
  },
  // Respect .gitignore so agent workflow files (tasks.md, plan.md, agent.md,
  // CLAUDE.md, .codex/) aren't scanned.
  "gitignore": true,
  // Without a positive glob markdownlint-cli2 matches nothing and the whole
  // gate silently passes, so state it explicitly.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    // Test-vault scenarios and feature notes are flashcard-syntax fixtures,
    // not prose docs: they carry plugin-written `^q-xxxx` anchors and start
    // with a body paragraph when the note itself is the card. The vault's own
    // README and note.md are prose and stay linted. .obsidian/ is
    // plugin-generated, and the same goes for the v1 example vault.
    "test-vault/scenarios/**",
    "test-vault/features/**",
    "test-vault/.obsidian/**",
    "docs/test-vault/**",
    "docs/demo.md",
    // Parser fixtures contain intentionally malformed markdown.
    "tests/fixtures/**",
    // Pinned benchmark fixtures: deterministic inputs, not prose.
    "tests/perf/_fixtures/*.md",
    ".obsidian/**",
    "main.js",
    // v1 marketing README, deferred to the v2 rewrite.
    "README.md"
  ]
}
