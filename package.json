{
  "name": "flashcards-obsidian",
  "version": "2.0.0",
  "description": "Anki flashcards for markdown notes with an Obsidian adapter.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "npm run lint && npm run lint:md && npm run test && npm run build",
    "coverage": "vitest run --coverage",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-vault:reset": "git checkout HEAD -- test-vault/scenarios/ test-vault/features/ && rm -f test-vault/.obsidian/plugins/flashcards-obsidian/data.json test-vault/.obsidian/plugins/flashcards-obsidian/sync.log && echo '✓ test-vault reset. Reload Obsidian (Cmd/Ctrl+R) to pick up clean state.'",
    "check:test-vault-ids": "bash scripts/check-test-vault-ids.sh",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.md": "markdownlint-cli2",
    "*.{json,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "obsidian",
    "anki",
    "flashcards"
  ],
  "author": "Alex Colucci",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^4.0.3",
    "esbuild": "^0.25.11",
    "eslint": "^9.39.1",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.3"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "obsidian": "latest",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
