{
  "name": "flashcards-obsidian",
  "version": "2.1.1",
  "description": "Anki flashcards for markdown notes with an Obsidian adapter.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg -o docs/architecture/graph.svg",
    "arch:likec4": "likec4 serve docs/architecture/likec4",
    "arch:likec4:build": "likec4 build -o docs/architecture/likec4/out docs/architecture/likec4",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "npm run lint && npm run lint:md && npm run arch:check && npm run dead-code:check && npm run test && npm run build",
    "dead-code:check": "knip --include files,dependencies,unlisted,exports",
    "coverage": "vitest run --coverage",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --experimental-strip-types scripts/bench-run.ts",
    "bench:compare": "node --experimental-strip-types scripts/bench-compare.ts",
    "bench:baseline": "cp .perf-current.json .perf-baseline.json",
    "test-vault:reset": "git checkout HEAD -- test-vault/scenarios/ test-vault/features/ && rm -f test-vault/.obsidian/plugins/flashcards-obsidian/data.json test-vault/.obsidian/plugins/flashcards-obsidian/sync.log && echo '\u2713 test-vault reset. Reload Obsidian (Cmd/Ctrl+R) to pick up clean state.'",
    "check:test-vault-ids": "bash scripts/check-test-vault-ids.sh",
    "fixture-media": "node --experimental-strip-types scripts/gen-fixture-media.ts",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "anki",
    "flashcards"
  ],
  "author": "Alex Colucci",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "dependency-cruiser": "17.4.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fast-check": "4.7.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.34.0",
    "likec4": "1.46.0",
    "markdownlint-cli2": "0.22.1",
    "nano-staged": "1.0.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-math": "3.1.0",
    "obsidian": "1.13.1",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "nano-staged": {
    "*.ts": "eslint --fix",
    "*.md": "markdownlint-cli2",
    "*.{json,yml,yaml}": "prettier --write"
  }
}
